        "/^python3 - <<'PY'\nimport re, pathlib\n\ndef slug\\(text\\):\n    t = text\\.strip\\(\\)\\.lower\\(\\)\n    t = re\\.sub\\(r'\\\\s\\+', ' ', t\\)\n    t = re\\.sub\\(r'\\[\\^\\\\w\\\\s-\\]', '', t\\)\n    t = re\\.sub\\(r'\\\\s\\+', '-', t\\.strip\\(\\)\\)\n    return t\n\nfiles = \\[\n    \"fee-management-api\\.mdx\",\n    \"fiat-payout-management\\.mdx\",\n    \"fx-setting\\.mdx\",\n    \"management-api\\.mdx\",\n    \"orderbook-management\\.mdx\",\n    \"trading-management\\.mdx\",\n    \"transactions\\.mdx\",\n    \"user-management\\.mdx\",\n    \"virtual-accounts\\.mdx\",\n    \"wallet\\.mdx\",\n\\]\n\nbase = pathlib\\.Path\\(\"/Users/charlesokaformbah/Projects/strails_docs/api-reference\"\\)\n\nfor fn in files:\n    p = base / fn\n    text = p\\.read_text\\(\\)\n    headings = re\\.findall\\(r'\\^\\(##\\|###\\)\\\\s\\+\\(\\.\\+\\)\\$', text, re\\.MULTILINE\\)\n    heading_slugs = \\{slug\\(h\\): h for _, h in headings\\}\n    # find overview heading line number then table start\n    lines = text\\.splitlines\\(\\)\n    overview_idx = None\n    for i, l in enumerate\\(lines\\):\n        if re\\.match\\(r'\\^##\\\\s\\+\\.\\*\\?Endpoints\\.\\*\\?\\(\\?:\\[Oo\\]verview\\)', l\\):\n            overview_idx = i\n            break\n    if overview_idx is None:\n        print\\(f\"\\\\n## \\{fn\\}\\\\nNO overview heading found\"\\)\n        continue\n    # find first table line after overview heading\n    table_start = None\n    for i in range\\(overview_idx\\+1, min\\(overview_idx\\+10, len\\(lines\\)\\)\\):\n        if lines\\[i\\]\\.startswith\\('\\|'\\):\n            table_start = i\n            break\n    if table_start is None:\n        print\\(f\"\\\\n## \\{fn\\}\\\\nNO table after overview heading\"\\)\n        continue\n    # collect table rows until blank line or separator line of --- or new heading\n    table_lines = \\[\\]\n    for i in range\\(table_start, len\\(lines\\)\\):\n        l = lines\\[i\\]\n        if not l\\.startswith\\('\\|'\\):\n            break\n        table_lines\\.append\\(l\\)\n    # parse rows\n    rows = \\[\\]\n    for l in table_lines:\n        cells = \\[c\\.strip\\(\\) for c in l\\.strip\\('\\|'\\)\\.split\\('\\|'\\)\\]\n        if len\\(cells\\) >= 4:\n            rows\\.append\\(cells\\)\n    if not rows:\n        print\\(f\"\\\\n## \\{fn\\}\\\\nTable empty\"\\)\n        continue\n    broken = \\[\\]\n    mismatches = \\[\\]\n    for cells in rows:\n        section_cell = cells\\[0\\]\n        link_match = re\\.search\\(r'\\\\\\[\\(\\[\\^\\\\\\]\\]\\+\\)\\\\\\]\\\\\\(\\(#\\[\\^\\)\\]\\+\\)\\\\\\)', section_cell\\)\n        if not link_match:\n            broken\\.append\\(\\(None, None, f\"No link in row: \\{section_cell\\}\"\\)\\)\n            continue\n        section_text, anchor = link_match\\.group\\(1\\), link_match\\.group\\(2\\)\\.lstrip\\('#'\\)\n        if anchor not in heading_slugs:\n            best = None\n            for _, h in headings:\n                if section_text\\.lower\\(\\) in h\\.lower\\(\\) or h\\.lower\\(\\) in section_text\\.lower\\(\\) or slug\\(h\\) == slug\\(section_text\\):\n                    best = h\n                    break\n            broken\\.append\\(\\(section_text, anchor, best or 'NO MATCHING HEADING'\\)\\)\n        else:\n            heading = heading_slugs\\[anchor\\]\n            st_words = set\\(re\\.findall\\(r'\\\\w\\+', section_text\\.lower\\(\\)\\)\\)\n            h_words = set\\(re\\.findall\\(r'\\\\w\\+', heading\\.lower\\(\\)\\)\\)\n            common = \\{'api', 'endpoint', 'the', 'a', 'an', 'for', 'to', 'and', 'of', 'get', 'post', 'put', 'delete'\\}\n            meaningful = st_words - common\n            if not any\\(w in h_words for w in meaningful\\):\n                mismatches\\.append\\(\\(section_text, heading, anchor\\)\\)\n    total_links = sum\\(1 for cells in rows for _ in re\\.finditer\\(r'\\\\\\[\\(\\[\\^\\\\\\]\\]\\+\\)\\\\\\]\\\\\\(\\(#\\[\\^\\)\\]\\+\\)\\\\\\)', cells\\[0\\]\\)\\)\n    print\\(f\"\\\\n## \\{fn\\}\"\\)\n    print\\(f\"- total overview links: \\{total_links\\}\"\\)\n    if broken:\n        print\\(\"- broken/mismatched anchors:\"\\)\n        for section_text, anchor, closest in broken:\n            print\\(f\"  - `\\{anchor\\}` \\(linked from \\\\\"\\{section_text\\}\\\\\"\\) -> closest heading: `\\{closest\\}`\"\\)\n    else:\n        print\\(\"- broken/mismatched anchors: none\"\\)\n    if mismatches:\n        print\\(\"- section/heading description mismatches:\"\\)\n        for section_text, heading, anchor in mismatches:\n            print\\(f\"  - anchor `#\\{anchor\\}`: overview says \\\\\"\\{section_text\\}\\\\\" but heading is \\\\\"\\{heading\\}\\\\\"\"\\)\n    else:\n        print\\(\"- section/heading description mismatches: none\"\\)\n    print\\(f\"- overall: \\{'OK' if not broken and not mismatches else 'NOT OK'\\}\"\\)\nPY$/": {
